{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste
    // worth refactoring. Lower to 2 to report every duplicate pair.
    "minOccurrences": 3,
    "ignore": [
      "src/app/**"
    ]
    // Common additions (uncomment to enable):
    // "ignore": [
    //   "**/lib/**",          // for repos that publish transpiled output to lib/
    //   "**/legacy/**",       // for repos with legacy-build artifacts
    //   "**/__generated__/**", // Relay, GraphQL Code Generator
    //   "**/generated/**"     // OpenAPI, Protobuf codegen
    // ]
  },
  "ignorePatterns": [
    "scripts/**"
  ],
  "audit": {
    "gate": "new-only"
  },
  "ignoreExports": [
    {
      "file": "src/components/pdp/pdp-tabby-catalog-v7.ts",
      "exports": ["*"]
    },
    {
      "file": "src/components/pdp/pdp-tabby-colors-v7.ts",
      "exports": ["*"]
    }
  ],
  "health": {
    "ignore": [
      "src/components/pdp/pdp-tabby-catalog-v7.ts",
      "src/components/pdp/pdp-tabby-colors-v7.ts"
    ],
    "thresholdOverrides": [
      {
        "files": [
          "src/components/pdp/pdp-compact-color-dots.tsx",
          "src/components/pdp/pdp-hero-360-intro-context.tsx",
          "src/components/pdp/pdp-hero-360-intro-layer.tsx",
          "src/components/pdp/pdp-hero-gallery-data.ts",
          "src/components/pdp/pdp-hero-gallery.tsx",
          "src/components/pdp/pdp-leather-aging-care-upsell.tsx",
          "src/components/pdp/use-hero-360-intro-reveal.ts",
          "src/components/pdp/use-hero-video-playback.ts",
          "src/components/pdp/use-infinite-centered-carousel.ts",
          "src/components/pdp/use-pdp-display-price.ts",
          "src/components/pdp/version/pdp-v2-reviews.tsx",
          "src/components/pdp/version/pdp-v3-hero-layout.tsx",
          "src/components/pdp/version/pdp-v5-*.tsx"
        ],
        "maxCrap": 1000,
        "maxCyclomatic": 50,
        "maxCognitive": 50,
        "reason": "v7 Skelly port UI — refactor deferred until post-feedback"
      }
    ]
  },
  "rules": {
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-dependency": "warn"
  }
}
